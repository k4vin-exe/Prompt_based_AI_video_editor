# ──────────────────────────────────────────────────────────────────────────────
# IncuBrix Prompt-Based AI Video Editor — Environment Configuration (.env)
# 
# QUICKSTART:
# 1. Copy this file to .env:
#    cp .env.example .env      (Linux / macOS)
#    copy .env.example .env    (Windows)
# 2. Choose your preferred AI provider below (Groq, Gemini, Ollama, or Mock).
# 3. Never commit your .env file containing real API keys to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Select Active AI Adapters ─────────────────────────────────────────────────
# LLM_ADAPTER options: "groq" | "gemini" | "huggingface" | "ollama" | "mock"
# STT_ADAPTER options: "groq" | "faster_whisper" | "mock"
#
# Default is "mock" for zero-key instant offline testing and CI.
# For full AI natural language perception, we recommend "groq" (fast & free).
LLM_ADAPTER=mock
STT_ADAPTER=mock

# ── 1. Groq (Recommended — Ultra-Fast, Free Tier: 30 RPM) ─────────────────────
# Get your free API key at: https://console.groq.com/keys
# Set LLM_ADAPTER=groq and/or STT_ADAPTER=groq above to use this key.
GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.1-8b-instant

# ── 2. Google Gemini (Free Tier: 15 RPM) ──────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/
# Set LLM_ADAPTER=gemini above to use this key.
GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-1.5-flash

# ── 3. Hugging Face Serverless (Free Tier) ────────────────────────────────────
# Get your free access token at: https://huggingface.co/settings/tokens
# Set LLM_ADAPTER=huggingface above to use this key.
HF_TOKEN=
LLM_HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── 4. Ollama (100% Local, Zero API Keys, Completely Private) ─────────────────
# Download and run Ollama from: https://ollama.ai/
# Run in terminal: ollama run llama3.2
# Set LLM_ADAPTER=ollama above to use local models.
OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3.2

# ── 5. faster-whisper (Local CPU Speech-to-Text) ──────────────────────────────
# Set STT_ADAPTER=faster_whisper above to transcribe locally on CPU/GPU.
STT_WHISPER_MODEL=base
STT_DIARIZATION=false

# ── Server & Database Settings ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DATABASE_URL=sqlite+aiosqlite:///./incubrix.db
STORAGE_DIR=./outputs/api_storage

# ── FFmpeg & Rendering Paths ──────────────────────────────────────────────────
# Path to ffmpeg/ffprobe binaries (leave blank if ffmpeg is in system PATH)
FFMPEG_BIN=
FFPROBE_BIN=
FRAME_ROUNDING=round_half_up

# ── NLU & Session Coordination ────────────────────────────────────────────────
TIME_POLICY=current_edited
INTENT_CACHE_DIR=./intent_cache
VAD_ADAPTER=none
VAD_SNAP_MARGIN_S=0.15

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
