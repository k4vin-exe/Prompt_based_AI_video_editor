# ──────────────────────────────────────────────────────────────────────────────
# IncuBrix Video Editor — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Use sqlite:///./incubrix.db for local dev without Docker.
# Use postgresql+asyncpg://user:pass@localhost:5432/incubrix for Docker.
DATABASE_URL=sqlite+aiosqlite:///./incubrix.db

# ── Object Storage (S3-compatible) ───────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=incubrix
STORAGE_REGION=us-east-1
# Set to true when using AWS S3 (disables path-style URLs)
STORAGE_USE_VIRTUAL_HOSTING=false

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Secret for HMAC-SHA256 callback signatures (X-IncuBrix-Signature)
API_CALLBACK_SECRET=changeme-in-production
# Bearer token for demo protection (leave blank to disable auth)
API_ACCESS_TOKEN=

# ── STT Adapter ───────────────────────────────────────────────────────────────
# Options: faster_whisper | groq | mock
STT_ADAPTER=mock
# faster-whisper model size: tiny | base | small | medium | large-v3
STT_WHISPER_MODEL=base
# Groq STT (only used when STT_ADAPTER=groq)
GROQ_API_KEY=
# Optional: HuggingFace token for pyannote diarization
HF_TOKEN=
# Enable speaker diarization (requires HF_TOKEN when using faster_whisper)
STT_DIARIZATION=false

# ── LLM Adapter ───────────────────────────────────────────────────────────────
# Options: groq | gemini | ollama | mock
LLM_ADAPTER=mock
# Groq LLM (llama-3.1-8b-instant is free tier)
# GROQ_API_KEY= (same key as STT, already set above)
LLM_GROQ_MODEL=llama-3.1-8b-instant
# Gemini (only used when LLM_ADAPTER=gemini)
GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-1.5-flash
# Ollama (only used when LLM_ADAPTER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3.1

# ── Embeddings Adapter ────────────────────────────────────────────────────────
# Options: fastembed | mock
EMBEDDINGS_ADAPTER=mock
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# ── Rendering ─────────────────────────────────────────────────────────────────
# Path to ffmpeg binary (leave blank to use system PATH)
FFMPEG_BIN=
FFPROBE_BIN=
# Frame rounding rule: round_half_up (documented in RULES.md)
FRAME_ROUNDING=round_half_up

# ── NLU / Intent ─────────────────────────────────────────────────────────────
# Time policy: current_edited | original_source
TIME_POLICY=current_edited
# Intent cache directory (LLM responses cached by hash for determinism)
INTENT_CACHE_DIR=./intent_cache

# ── VAD (Voice Activity Detection for cut snapping) ──────────────────────────
# Options: silero | energy | none
VAD_ADAPTER=none
# Snap cut boundaries to nearest silence within this many seconds
VAD_SNAP_MARGIN_S=0.15

# ── Worker / Job Queue ────────────────────────────────────────────────────────
# Options: inline (runs in API process, good for dev) | celery
WORKER_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Filler Detection ─────────────────────────────────────────────────────────
# Minimum pause after 'like' to count as filler (seconds)
FILLER_LIKE_MIN_PAUSE_S=0.15

# ── Performance ──────────────────────────────────────────────────────────────
# Target max instruction latency in seconds (used in tests)
MAX_INSTRUCTION_LATENCY_S=3.0
