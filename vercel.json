{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/web/$1"
    },
    {
      "source": "/tests/fixtures/(.*)",
      "destination": "/tests/fixtures/$1"
    },
    {
      "source": "/demo",
      "destination": "/web/index.html"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/ready",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    }
  ]
}
